---
import ActionLink from '@/components/ActionLink.astro';
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteContent } from '@/lib/sanity';
import { resolvePageSeo } from '@/lib/page-seo';

const content = await getSiteContent();
const { settings, businessHours, specialHours } = content;
const preparation = [
  { name: '와플', time: '약 15분', note: '주문 후 굽기 시작' },
  { name: '컵 떡볶이', time: '약 10분', note: '메뉴별 구성 확인' },
  { name: '또띠아 랩', time: '약 30분', note: '순한맛·매운맛 선택' },
  { name: '홀케이크', time: '최소 하루 전', note: '예약 조건 확인 필요' },
];
const seo = resolvePageSeo(content, '/order', {
  title: '온라인 주문과 픽업',
  description: '와플톡 온라인 주문 방법과 메뉴별 예상 준비시간을 확인하고 페이히어에서 미리 주문해 픽업하세요.',
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonical ?? seo.path}
  ogImage={seo.shareImageUrl}
  settings={settings}
  businessHours={businessHours}
  specialHours={specialHours}
>
  <header class="order-hero">
    <div class="shell order-hero__grid">
      <div>
        <p class="eyebrow">Order first, pick up easy</p>
        <h1>굽는 동안 기다리지 않도록,<br />오는 길에 주문하세요.</h1>
        <p class="order-hero__lead">페이히어에서 메뉴를 고르고 주문하면 매장에서 확인 후 준비합니다. 주문 가능 여부와 최종 준비시간은 외부 주문 화면에서 확인해 주세요.</p>
        <ActionLink href={settings.links.order} label="페이히어 온라인 주문 열기" icon="external" event="order_click" location="order_hero" />
      </div>
      <ol class="order-steps" aria-label="온라인 주문 순서">
        <li><span>01</span><div><strong>메뉴 고르기</strong><p>가격과 판매 여부를 확인해요.</p></div></li>
        <li><span>02</span><div><strong>픽업 주문하기</strong><p>페이히어 주문 안내를 따라요.</p></div></li>
        <li><span>03</span><div><strong>매장에서 받기</strong><p>옥천로 34, 1층 102호로 오세요.</p></div></li>
      </ol>
    </div>
  </header>

  <section class="section shell" aria-labelledby="prep-title">
    <div class="section-heading">
      <p class="eyebrow">Preparation guide</p>
      <h2 id="prep-title">메뉴별 준비시간 안내</h2>
      <p class="muted">아래 시간은 매장 안내 기준이며 보장 시간이 아닙니다. 주문량에 따라 달라질 수 있습니다.</p>
    </div>
    <div class="prep-grid">
      {preparation.map((item, index) => (
        <article class="prep-card">
          <span class="prep-card__number">{String(index + 1).padStart(2, '0')}</span>
          <Icon name="clock" />
          <h3>{item.name}</h3>
          <strong>{item.time}</strong>
          <p>{item.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section order-fallback" aria-labelledby="fallback-title">
    <div class="shell order-fallback__grid">
      <div>
        <p class="eyebrow">If the store page is unavailable</p>
        <h2 id="fallback-title">주문 페이지가 열리지 않나요?</h2>
        <p>온라인 스토어 장애나 메뉴 문의가 있을 때는 전화로 확인해 주세요. 카카오톡 공식 문의 링크는 운영자 승인 후 추가합니다.</p>
      </div>
      <div class="action-row">
        <ActionLink href={settings.telephoneHref} label={`${settings.telephone} 전화하기`} icon="phone" event="phone_click" location="order_fallback" />
        <ActionLink href="/store" label="픽업 위치 확인" icon="map" variant="outline" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .order-hero {
    border-bottom: 2px solid var(--color-toast-800);
    background: var(--color-batter-400);
    padding-block: clamp(3rem, 9vw, 7rem);
  }

  .order-hero__grid {
    display: grid;
    gap: clamp(2rem, 7vw, 5rem);
    align-items: center;
  }

  .order-hero__lead {
    max-width: 42rem;
    font-size: 1.12rem;
  }

  .order-steps {
    display: grid;
    gap: 0;
    margin: 0;
    border: 2px solid var(--color-toast-800);
    border-radius: 1rem;
    background: var(--color-cream-50);
    padding: 0;
    list-style: none;
    box-shadow: 0.75rem 0.75rem 0 var(--color-toast-800);
  }

  .order-steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.25rem;
  }

  .order-steps li + li {
    border-top: 1px dashed color-mix(in srgb, var(--color-toast-800) 45%, transparent);
  }

  .order-steps span,
  .prep-card__number {
    color: var(--color-berry-600);
    font-family: var(--font-utility);
    font-weight: 700;
  }

  .order-steps strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .order-steps p,
  .prep-card p {
    margin: 0;
    color: var(--color-ink-700);
  }

  .prep-grid {
    display: grid;
    gap: 1rem;
  }

  .prep-card {
    position: relative;
    display: grid;
    min-height: 15rem;
    gap: 0.5rem;
    align-content: end;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-toast-800) 22%, transparent);
    border-radius: 1rem;
    background: white;
    padding: 1.5rem;
  }

  .prep-card::before {
    position: absolute;
    top: -2.2rem;
    right: -2.2rem;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--color-batter-100);
    content: '';
  }

  .prep-card :global(.icon) {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    color: var(--color-toast-800);
  }

  .prep-card h3,
  .prep-card strong {
    margin: 0;
  }

  .prep-card strong {
    font-family: var(--font-utility);
    font-size: 1.3rem;
  }

  .order-fallback {
    border-block: 2px solid var(--color-toast-800);
    background: var(--color-cream-100);
  }

  .order-fallback__grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .order-fallback h2,
  .order-fallback p:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 40rem) {
    .prep-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .order-hero__grid {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .prep-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .order-fallback__grid {
      grid-template-columns: 1fr auto;
    }
  }
</style>
