---
import ActionLink from '@/components/ActionLink.astro';
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteContent } from '@/lib/sanity';
import { resolvePageSeo } from '@/lib/page-seo';

const content = await getSiteContent();
const { settings, businessHours, specialHours } = content;
const preparation = [
  { name: '와플', time: '약 15분', note: '주문을 확인한 뒤 구워요' },
  { name: '컵 떡볶이', time: '약 10분', note: '메뉴별 구성을 확인해요' },
  { name: '또띠아 랩', time: '약 30분', note: '순한맛과 매운맛 중 골라요' },
  { name: '홀케이크', time: '최소 1일 전', note: '예약 조건을 먼저 확인해요' },
];
const seo = resolvePageSeo(content, '/order', {
  title: '온라인 주문과 픽업',
  description: '와플톡 온라인 주문 방법과 메뉴별 예상 준비시간을 확인하고 페이히어에서 미리 주문해 픽업하세요.',
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonical ?? seo.path}
  ogImage={seo.shareImageUrl}
  settings={settings}
  businessHours={businessHours}
  specialHours={specialHours}
>
  <header class="order-hero">
    <div class="shell order-hero__grid">
      <div class="order-hero__copy">
        <p class="section-kicker">미리 주문하고 픽업하기</p>
        <h1>오는 길에 주문하면<br />덜 기다릴 수 있어요</h1>
        <p>페이히어에서 메뉴를 고르고 주문해 주세요. 매장에서 주문을 확인한 뒤 준비해요.</p>
        <ActionLink href={settings.links.order} label="메뉴 보고 주문하기" icon="order" event="order_click" location="order_hero" />
      </div>
      <ol class="order-steps" aria-label="온라인 주문 순서">
        <li><span>1</span><div><strong>메뉴를 골라요</strong><p>가격과 판매 여부를 확인해요.</p></div></li>
        <li><span>2</span><div><strong>픽업 주문을 남겨요</strong><p>페이히어 안내에 따라 주문해요.</p></div></li>
        <li><span>3</span><div><strong>매장에서 찾아가요</strong><p>옥천로 34, 1층 102호예요.</p></div></li>
      </ol>
    </div>
  </header>

  <section class="section shell" aria-labelledby="prep-title">
    <div class="section-heading">
      <p class="section-kicker">예상 준비시간</p>
      <h2 id="prep-title">메뉴마다 준비시간이 달라요</h2>
      <p class="muted">아래 시간은 매장 안내 기준이에요. 주문량에 따라 달라질 수 있어요.</p>
    </div>
    <dl class="prep-list">
      {preparation.map((item) => (
        <div class="prep-item">
          <Icon name="clock" />
          <dt><strong>{item.name}</strong><span>{item.note}</span></dt>
          <dd>{item.time}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section order-fallback" aria-labelledby="fallback-title">
    <div class="shell order-fallback__grid">
      <div>
        <p class="section-kicker">다른 주문 방법</p>
        <h2 id="fallback-title">주문 화면이 열리지 않나요?</h2>
        <p>온라인 주문이 어렵거나 메뉴가 궁금하면 전화로 확인해 주세요.</p>
      </div>
      <div class="action-row">
        <ActionLink href={settings.telephoneHref} label="전화로 확인하기" icon="phone" event="phone_click" location="order_fallback" />
        <ActionLink href="/store" label="픽업 위치 보기" variant="weak" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .order-hero {
    padding-block: clamp(var(--dimension-x10), 8vw, 5.5rem);
  }

  .order-hero__grid {
    display: grid;
    gap: var(--dimension-x10);
    align-items: center;
  }

  .order-hero__copy {
    display: grid;
    gap: var(--dimension-x5);
    justify-items: start;
  }

  .order-hero h1,
  .order-hero p {
    margin-bottom: 0;
  }

  .order-hero__copy > p:not(.section-kicker) {
    max-width: 38rem;
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t6);
    line-height: var(--line-height-t7);
  }

  .order-steps {
    display: grid;
    gap: 0;
    margin: 0;
    border-radius: var(--radius-r4);
    background: var(--color-bg-neutral-weak);
    padding: var(--dimension-x2) var(--dimension-x5);
    list-style: none;
  }

  .order-steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--dimension-x3);
    padding-block: var(--dimension-x4);
  }

  .order-steps li + li {
    border-top: 1px solid var(--color-stroke-neutral-muted);
  }

  .order-steps span {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--color-bg-layer-default);
    color: var(--color-fg-brand);
    font-size: var(--font-size-t3);
    font-weight: var(--font-weight-bold);
  }

  .order-steps strong {
    font-size: var(--font-size-t5);
  }

  .order-steps p {
    margin-top: var(--dimension-x1);
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t4);
    line-height: var(--line-height-t4);
  }

  .prep-list {
    margin: 0;
    border-top: 1px solid var(--color-stroke-neutral-muted);
  }

  .prep-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: var(--dimension-x3);
    align-items: center;
    border-bottom: 1px solid var(--color-stroke-neutral-subtle);
    padding-block: var(--dimension-x5);
  }

  .prep-item :global(.seed-icon) {
    color: var(--color-fg-brand);
  }

  .prep-item dt {
    display: grid;
    gap: var(--dimension-x1);
  }

  .prep-item dt span {
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t4);
    line-height: var(--line-height-t4);
  }

  .prep-item dd {
    margin: 0;
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .order-fallback {
    background: var(--color-bg-brand-weak);
  }

  .order-fallback__grid {
    display: grid;
    gap: var(--dimension-x6);
    align-items: center;
  }

  .order-fallback h2,
  .order-fallback p:last-child {
    margin-bottom: 0;
  }

  .order-fallback p:last-child {
    color: var(--color-fg-neutral-muted);
  }

  @media (min-width: 56rem) {
    .order-hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 5rem;
    }

    .order-fallback__grid {
      grid-template-columns: 1fr auto;
    }
  }
</style>
