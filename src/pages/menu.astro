---
import ActionLink from '@/components/ActionLink.astro';
import MenuCard from '@/components/MenuCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteContent } from '@/lib/sanity';
import { resolvePageSeo } from '@/lib/page-seo';

const content = await getSiteContent();
const { settings, businessHours, specialHours, categories, menuItems } = content;
const visibleCategories = categories.filter((category) =>
  menuItems.some((item) => item.categoryId === category.id),
);
const seo = resolvePageSeo(content, '/menu', {
  title: '메뉴와 가격',
  description: '와플톡의 옛날 와플, 생크림 와플, 누텔라 와플, 컵 떡볶이, 또띠아와 홀케이크 메뉴 및 가격을 확인하세요.',
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonical ?? seo.path}
  ogImage={seo.shareImageUrl}
  settings={settings}
  businessHours={businessHours}
  specialHours={specialHours}
  pageEvent="menu_view"
>
  <header class="page-intro shell">
    <p class="section-kicker">와플톡 메뉴</p>
    <h1>메뉴와 가격을<br />한눈에 확인하세요</h1>
    <p>와플부터 떡볶이, 또띠아, 케이크까지 모아두었어요. 판매 중인 메뉴는 주문 화면에서 가장 정확하게 확인할 수 있어요.</p>
    <div class="action-row">
      <ActionLink href={settings.links.order} label="메뉴 보고 주문하기" icon="order" event="order_click" location="menu_intro" />
      <ActionLink href="/order" label="준비시간 보기" variant="weak" />
    </div>
  </header>

  <nav class="category-nav" aria-label="메뉴 분류">
    <div class="shell category-nav__inner">
      {visibleCategories.map((category) => <a href={`#${category.id}`}>{category.title}</a>)}
    </div>
  </nav>

  <div class="shell menu-sections">
    {visibleCategories.map((category) => {
      const items = menuItems.filter((item) => item.categoryId === category.id);
      return (
        <section class="menu-section" id={category.id} aria-labelledby={`${category.id}-title`}>
          <div class="menu-section__heading">
            <h2 id={`${category.id}-title`}>{category.title}</h2>
            <p>{category.description}</p>
          </div>
          <div class="menu-grid">
            {items.map((item) => <MenuCard item={item} orderUrl={settings.links.order} showOrder location="menu_list" />)}
          </div>
        </section>
      );
    })}
  </div>

  <aside class="shell menu-note" aria-labelledby="menu-note-title">
    <div>
      <strong id="menu-note-title">준비시간 안내</strong>
      <p>표시된 시간은 매장 안내 기준이에요. 주문량과 재료 상황에 따라 달라질 수 있으니 주문 화면에서 다시 확인해 주세요.</p>
    </div>
    <ActionLink href={settings.telephoneHref} label="전화로 확인하기" icon="phone" variant="weak" event="phone_click" location="menu_note" />
  </aside>
</BaseLayout>

<style>
  .page-intro {
    display: grid;
    gap: var(--dimension-x4);
    justify-items: start;
  }

  .page-intro h1,
  .page-intro p {
    margin-bottom: 0;
  }

  .category-nav {
    position: sticky;
    top: 4rem;
    z-index: 10;
    border-block: 1px solid var(--color-stroke-neutral-subtle);
    background: color-mix(in srgb, var(--color-bg-layer-default) 96%, transparent);
    backdrop-filter: blur(12px);
  }

  .category-nav__inner {
    display: flex;
    gap: var(--dimension-x6);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .category-nav__inner::-webkit-scrollbar {
    display: none;
  }

  .category-nav a {
    flex: 0 0 auto;
    min-height: 3.25rem;
    padding-block: 0.9375rem 0.8125rem;
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t4);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
  }

  .category-nav a:hover {
    color: var(--color-fg-brand);
  }

  .menu-sections {
    padding-block: var(--dimension-x4) var(--dimension-x16);
  }

  .menu-section {
    padding-block: var(--dimension-x12);
    scroll-margin-top: 7.5rem;
  }

  .menu-section + .menu-section {
    border-top: 1px solid var(--color-stroke-neutral-muted);
  }

  .menu-section__heading {
    display: grid;
    gap: var(--dimension-x2);
    margin-bottom: var(--dimension-x4);
  }

  .menu-section__heading h2,
  .menu-section__heading p {
    margin-bottom: 0;
  }

  .menu-section__heading p {
    color: var(--color-fg-neutral-muted);
  }

  .menu-grid {
    display: grid;
    gap: 0 var(--dimension-x8);
  }

  .menu-note {
    display: grid;
    gap: var(--dimension-x5);
    align-items: center;
    margin-bottom: var(--dimension-x16);
    border-radius: var(--radius-r4);
    background: var(--color-bg-neutral-weak);
    padding: var(--dimension-x5);
  }

  .menu-note strong {
    display: block;
    margin-bottom: var(--dimension-x1);
    font-size: var(--font-size-t5);
  }

  .menu-note p {
    margin: 0;
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t4);
    line-height: var(--line-height-t4);
  }

  @media (min-width: 40rem) {
    .menu-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .category-nav {
      top: 4.5rem;
    }

    .menu-section__heading,
    .menu-note {
      grid-template-columns: 1fr auto;
    }

    .menu-section__heading p {
      max-width: 28rem;
      align-self: end;
      text-align: right;
    }

    .menu-note {
      padding: var(--dimension-x6);
    }
  }
</style>
