---
import ActionLink from '@/components/ActionLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteContent } from '@/lib/sanity';

const { settings, businessHours, specialHours } = await getSiteContent();
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청한 와플톡 페이지를 찾을 수 없습니다. 메뉴를 확인하거나 온라인 주문으로 이동하세요."
  settings={settings}
  businessHours={businessHours}
  specialHours={specialHours}
>
  <section class="shell not-found">
    <p class="eyebrow">404 · Pick-up slip missing</p>
    <h1>주문표가<br />어디로 갔을까요?</h1>
    <p>요청한 페이지가 없거나 주소가 바뀌었습니다. 메뉴로 돌아가 다시 골라 주세요.</p>
    <div class="action-row">
      <ActionLink href="/menu" label="메뉴로 돌아가기" icon="menu" />
      <ActionLink href="/" label="홈으로 이동" icon="arrow" variant="outline" />
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    min-height: 65vh;
    gap: 1rem;
    align-content: center;
    justify-items: start;
    padding-block: 4rem;
  }

  .not-found p:not(.eyebrow) {
    max-width: 35rem;
    color: var(--color-ink-700);
  }
</style>
