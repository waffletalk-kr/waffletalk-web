---
import ActionLink from '@/components/ActionLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteContent } from '@/lib/sanity';
import { resolvePageSeo } from '@/lib/page-seo';

const content = await getSiteContent();
const { settings, businessHours, specialHours } = content;
const seo = resolvePageSeo(content, '/story', {
  title: '와플톡 이야기',
  description: '강릉 옥천동 와플톡이 주문을 받고 와플을 준비하는 방식과 계절 메뉴, 동네 단골 가게의 이야기를 소개합니다.',
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonical ?? seo.path}
  ogImage={seo.shareImageUrl}
  settings={settings}
  businessHours={businessHours}
  specialHours={specialHours}
>
  <header class="story-hero">
    <div class="shell story-hero__grid">
      <div>
        <p class="section-kicker">강릉 옥천동 와플톡</p>
        <h1>주문을 확인한 뒤<br />와플을 준비해요</h1>
      </div>
      <p>와플톡은 테이크아웃 중심의 동네 가게예요. 따뜻한 와플을 편하게 찾아갈 수 있도록 주문과 픽업 정보를 정확하게 전하려고 해요.</p>
    </div>
  </header>

  <section class="section shell story-process" aria-labelledby="process-title">
    <div class="section-heading">
      <p class="section-kicker">와플이 준비되는 순서</p>
      <h2 id="process-title">주문부터 픽업까지</h2>
    </div>
    <ol class="process-list">
      <li><span>1</span><div><h3>주문을 확인해요</h3><p>메뉴와 픽업 요청을 확인해요. 미리 주문하면 매장에서 기다리는 시간을 줄일 수 있어요.</p></div></li>
      <li><span>2</span><div><h3>와플을 구워요</h3><p>주문 뒤 조리하는 방식의 정확한 범위는 매장 확인을 거쳐 과정 사진과 함께 소개할게요.</p></div></li>
      <li><span>3</span><div><h3>크림을 채워 건네요</h3><p>크림과 과일청을 만드는 범위도 확인된 내용만 솔직하게 전할게요.</p></div></li>
    </ol>
  </section>

  <section class="section story-neighborhood" aria-labelledby="neighborhood-title">
    <div class="shell story-neighborhood__grid">
      <div>
        <p class="section-kicker">동네에서 만나는 가게</p>
        <h2 id="neighborhood-title">다시 찾기 쉬운<br />와플 가게가 되도록</h2>
      </div>
      <div>
        <p>방문 후기에서는 친절한 응대와 단골 메모가 여러 번 언급돼요. 홈페이지에서도 과장된 표현보다 오늘 영업하는지, 무엇을 주문할 수 있는지부터 정확하게 알려드릴게요.</p>
        <ActionLink href={settings.links.naverPlace} label="네이버 플레이스에서 보기" icon="external" variant="weak" />
      </div>
    </div>
  </section>

  <section class="section shell story-season" aria-labelledby="season-title">
    <div>
      <p class="section-kicker">제철 메뉴</p>
      <h2 id="season-title">지금 주문할 수 있는<br />메뉴만 보여드릴게요</h2>
    </div>
    <div>
      <p>과일 메뉴는 계절과 재료에 따라 달라질 수 있어요.</p>
      <ActionLink href="/menu" label="현재 메뉴 보기" icon="arrow" variant="outline" />
    </div>
  </section>
</BaseLayout>

<style>
  .story-hero {
    padding-block: clamp(var(--dimension-x10), 8vw, 5.5rem);
  }

  .story-hero__grid {
    display: grid;
    gap: var(--dimension-x6);
    align-items: end;
  }

  .story-hero h1,
  .story-hero p {
    margin-bottom: 0;
  }

  .story-hero__grid > p {
    max-width: 37rem;
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t6);
    line-height: var(--line-height-t7);
  }

  .process-list {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-stroke-neutral-muted);
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--dimension-x4);
    border-bottom: 1px solid var(--color-stroke-neutral-subtle);
    padding-block: var(--dimension-x5);
  }

  .process-list span {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--color-bg-brand-weak);
    color: var(--color-fg-brand);
    font-size: var(--font-size-t3);
    font-weight: var(--font-weight-bold);
  }

  .process-list h3,
  .process-list p {
    margin-bottom: 0;
  }

  .process-list p {
    max-width: 45rem;
    margin-top: var(--dimension-x1);
    color: var(--color-fg-neutral-muted);
  }

  .story-neighborhood {
    background: var(--color-bg-layer-fill);
  }

  .story-neighborhood__grid,
  .story-season {
    display: grid;
    gap: var(--dimension-x6);
    align-items: center;
  }

  .story-neighborhood h2,
  .story-neighborhood p,
  .story-season h2,
  .story-season p {
    margin-bottom: 0;
  }

  .story-neighborhood__grid > div:last-child,
  .story-season > div:last-child {
    display: grid;
    gap: var(--dimension-x5);
    justify-items: start;
    color: var(--color-fg-neutral-muted);
  }

  @media (min-width: 48rem) {
    .story-hero__grid,
    .story-neighborhood__grid,
    .story-season {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 5rem;
    }

    .process-list li {
      grid-template-columns: 3rem 1fr;
    }
  }
</style>
