---
import ActionLink from '@/components/ActionLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSiteContent } from '@/lib/sanity';
import { resolvePageSeo } from '@/lib/page-seo';

const content = await getSiteContent();
const { settings, businessHours, specialHours } = content;
const seo = resolvePageSeo(content, '/story', {
  title: '와플톡 이야기',
  description: '강릉 옥천동 와플톡이 주문을 받고 와플을 준비하는 방식과 계절 메뉴, 동네 단골 가게의 이야기를 소개합니다.',
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonical ?? seo.path}
  ogImage={seo.shareImageUrl}
  settings={settings}
  businessHours={businessHours}
  specialHours={specialHours}
>
  <header class="story-hero">
    <div class="shell story-hero__grid">
      <div>
        <p class="eyebrow">A neighborhood waffle shop</p>
        <h1>주문을 받고 굽는 시간도<br />와플톡의 맛입니다.</h1>
      </div>
      <p>방문 후기와 등록 정보에서 반복해서 보인 와플톡의 모습은 ‘바로 준비하는 와플’과 ‘취향을 기억하는 동네 가게’였습니다. 홈페이지에는 매장주가 승인한 사실과 매장 소유 사진만 차곡차곡 담습니다.</p>
    </div>
  </header>

  <section class="section shell story-process" aria-labelledby="process-title">
    <div class="section-heading">
      <p class="eyebrow">The way we prepare</p>
      <h2 id="process-title">한 장의 와플이 픽업되기까지</h2>
    </div>
    <ol class="process-list">
      <li><span>01</span><div><h3>주문을 확인하고</h3><p>메뉴와 픽업 요청을 확인합니다. 온라인 주문을 이용하면 현장 대기를 줄일 수 있어요.</p></div></li>
      <li><span>02</span><div><h3>와플을 굽고</h3><p>주문 후 와플을 굽는 즉시 제조 방식은 운영자 최종 확인 후 과정 사진과 함께 더 정확히 소개합니다.</p></div></li>
      <li><span>03</span><div><h3>크림을 채워 건네요</h3><p>크림과 과일청을 만드는 범위, 제철 재료 원칙은 승인된 표현만 사용합니다.</p></div></li>
    </ol>
  </section>

  <section class="section story-notes" aria-labelledby="notes-title">
    <div class="shell story-notes__grid">
      <div class="notes-visual" aria-hidden="true">
        <span>“오늘도 잘 먹었어요”</span>
        <span>“다음엔 누텔라!”</span>
        <span>“맵달 조합 성공”</span>
      </div>
      <div>
        <p class="eyebrow">Regulars’ memo</p>
        <h2 id="notes-title">메모가 쌓이는 동네 가게</h2>
        <p>후기에서 확인되는 포스트잇과 단골 문화는 와플톡다운 장면입니다. 실제 사진을 사용할 때는 이름·전화번호·얼굴 등 개인정보가 보이지 않도록 확인합니다.</p>
        <ActionLink href={settings.links.naverPlace} label="네이버 플레이스에서 매장 보기" icon="external" variant="outline" />
      </div>
    </div>
  </section>

  <section class="section shell story-season" aria-labelledby="season-title">
    <div>
      <p class="eyebrow">Seasonal fruit</p>
      <h2 id="season-title">계절이 바뀌면,<br />메뉴도 정확히 바꿉니다.</h2>
    </div>
    <div>
      <p>복숭아·감귤·블루베리·딸기 계열 메뉴 가능성은 확인되었지만 현재 판매 여부는 달라질 수 있습니다. 제철 메뉴는 담당자가 정해지고 월 1회 이상 관리할 수 있을 때만 독립 공지로 공개합니다.</p>
      <ActionLink href="/menu" label="현재 메뉴 확인하기" icon="menu" variant="weak" />
    </div>
  </section>
</BaseLayout>

<style>
  .story-hero {
    border-bottom: 2px solid var(--color-toast-800);
    background: var(--color-batter-400);
    padding-block: clamp(3.5rem, 10vw, 8rem);
  }

  .story-hero__grid {
    display: grid;
    gap: 2rem;
  }

  .story-hero h1,
  .story-hero p {
    margin-bottom: 0;
  }

  .story-hero__grid > p {
    max-width: 35rem;
    align-self: end;
    font-size: 1.08rem;
  }

  .process-list {
    display: grid;
    margin: 0;
    border-top: 2px solid var(--color-toast-800);
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 4vw, 3rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-toast-800) 30%, transparent);
    padding-block: 1.5rem;
  }

  .process-list span {
    color: var(--color-berry-600);
    font-family: var(--font-utility);
    font-weight: 700;
  }

  .process-list h3,
  .process-list p {
    margin-bottom: 0;
  }

  .process-list p {
    color: var(--color-ink-700);
  }

  .story-notes {
    border-block: 2px solid var(--color-toast-800);
    background: var(--color-cream-100);
  }

  .story-notes__grid {
    display: grid;
    gap: clamp(2rem, 7vw, 5rem);
    align-items: center;
  }

  .notes-visual {
    position: relative;
    min-height: 20rem;
  }

  .notes-visual span {
    position: absolute;
    display: grid;
    width: 9.5rem;
    min-height: 9.5rem;
    place-items: center;
    border: 1px solid rgba(90, 46, 27, 0.2);
    background: var(--color-batter-100);
    padding: 1rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-align: center;
    box-shadow: 0.35rem 0.4rem 0 rgba(90, 46, 27, 0.12);
  }

  .notes-visual span:nth-child(1) { top: 0; left: 2%; transform: rotate(-5deg); }
  .notes-visual span:nth-child(2) { top: 3.5rem; right: 4%; transform: rotate(6deg); background: #ffd8e2; }
  .notes-visual span:nth-child(3) { bottom: 0; left: 28%; transform: rotate(2deg); background: #dcecd8; }

  .story-season {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .story-season h2,
  .story-season p {
    margin-bottom: 0;
  }

  .story-season p {
    margin-bottom: 1.25rem;
    color: var(--color-ink-700);
  }

  @media (min-width: 48rem) {
    .story-hero__grid,
    .story-notes__grid,
    .story-season {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .process-list li {
      grid-template-columns: 4rem 1fr;
    }
  }
</style>
