---
import ActionLink from '@/components/ActionLink.astro';
import BusinessStatus from '@/components/BusinessStatus.astro';
import Icon from '@/components/Icon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatHours } from '@/lib/business-hours';
import { getSiteContent } from '@/lib/sanity';
import { resolvePageSeo } from '@/lib/page-seo';

const content = await getSiteContent();
const { settings, businessHours, specialHours } = content;
const secondaryMaps = [
  { name: '카카오맵', href: settings.links.kakaoMap, service: 'kakao' },
  { name: 'Google Maps', href: settings.links.googleMaps, service: 'google' },
];
const seo = resolvePageSeo(content, '/store', {
  title: '매장 안내와 영업시간',
  description: '강릉시 옥천로 34 와플톡의 주소, 전화, 영업시간, 주차 및 네이버지도·카카오맵·Google Maps 길찾기를 확인하세요.',
});
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonicalPath={seo.canonical ?? seo.path}
  ogImage={seo.shareImageUrl}
  settings={settings}
  businessHours={businessHours}
  specialHours={specialHours}
>
  <header class="page-intro shell store-intro">
    <div class="store-intro__copy">
      <p class="section-kicker">와플톡 매장 안내</p>
      <h1>옥천로 34에서<br />찾아가세요</h1>
      <p>강릉 옥천동에 있는 테이크아웃 중심 매장이에요. 방문 전에 영업 상태와 주문 가능 여부를 확인해 주세요.</p>
      <BusinessStatus businessHours={businessHours} specialHours={specialHours} />
    </div>
    <aside class="store-summary" aria-label="매장 핵심 정보">
      <div><Icon name="map" /><span>주소</span><strong>{settings.streetAddress}</strong></div>
      <div><Icon name="phone" /><span>전화</span><a href={settings.telephoneHref} data-analytics-event="phone_click" data-analytics-location="store_summary">{settings.telephone}</a></div>
      <div><Icon name="order" /><span>이용</span><strong>테이크아웃 중심</strong></div>
    </aside>
  </header>

  <section class="section store-details" aria-labelledby="store-address-title">
    <div class="shell store-details__grid">
      <article class="store-section">
        <p class="section-kicker">주소와 길찾기</p>
        <h2 id="store-address-title">{settings.address}</h2>
        <p>건물 1층 102호에서 주문한 메뉴를 찾아가세요.</p>
        <div class="map-primary">
          <ActionLink href={settings.links.naverMap} label="네이버지도에서 길찾기" icon="map" event="directions_click" location="store_maps" service="naver" />
        </div>
        <div class="map-secondary">
          {secondaryMaps.map((map) => (
            <a href={map.href} data-analytics-event="directions_click" data-analytics-location="store_maps" data-analytics-service={map.service}>{map.name}에서 길찾기</a>
          ))}
        </div>
      </article>

      <article class="store-section">
        <p class="section-kicker">영업시간</p>
        <h2>방문 전에 확인해 주세요</h2>
        {settings.hoursVerified && businessHours.length ? (
          <dl class="hours-list">
            {businessHours.map((entry) => <><dt>{entry.label}</dt><dd>{formatHours(entry)}</dd></>)}
          </dl>
        ) : (
          <div class="notice">
            <strong>영업시간을 확인하고 있어요</strong>
            <p>토요일 영업과 공휴일·임시휴무, 마지막 주문 시간을 확인한 뒤 바로 알려드릴게요.</p>
          </div>
        )}
        <ActionLink href={settings.telephoneHref} label="전화로 영업 확인하기" icon="phone" variant="weak" event="phone_click" location="store_hours" />
      </article>
    </div>
  </section>

  <section class="section shell arrival" aria-labelledby="parking-title">
    <div class="section-heading">
      <p class="section-kicker">주차와 픽업</p>
      <h2 id="parking-title">도착하기 전에 알아두세요</h2>
    </div>
    <div class="arrival-list">
      <article>
        <Icon name="map" />
        <div><h3>강릉 동부시장 공영주차장</h3><p>공영주차장 이용 안내가 등록되어 있어요. 1시간 무료 조건과 주차권 제공 여부는 확인 중이에요.</p></div>
      </article>
      <article>
        <Icon name="order" />
        <div><h3>건물 1층 102호에서 픽업</h3><p>매장 안에서 오래 머무는 카페보다 주문한 메뉴를 찾아가는 테이크아웃 이용에 맞춰져 있어요.</p></div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .store-intro {
    display: grid;
    gap: var(--dimension-x10);
    align-items: center;
  }

  .store-intro__copy {
    display: grid;
    gap: var(--dimension-x4);
    justify-items: start;
  }

  .store-intro h1,
  .store-intro p {
    margin-bottom: 0;
  }

  .store-summary {
    border-radius: var(--radius-r4);
    background: var(--color-bg-neutral-weak);
    padding-inline: var(--dimension-x5);
  }

  .store-summary > div {
    display: grid;
    grid-template-columns: 1.5rem 4rem minmax(0, 1fr);
    gap: var(--dimension-x3);
    align-items: center;
    padding-block: var(--dimension-x4);
  }

  .store-summary > div + div {
    border-top: 1px solid var(--color-stroke-neutral-muted);
  }

  .store-summary :global(.seed-icon) {
    color: var(--color-fg-brand);
  }

  .store-summary span {
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t4);
  }

  .store-summary strong,
  .store-summary a {
    justify-self: end;
    font-weight: var(--font-weight-bold);
    text-align: right;
  }

  .store-details {
    background: var(--color-bg-layer-fill);
  }

  .store-details__grid {
    display: grid;
    gap: var(--dimension-x16);
  }

  .store-section {
    display: grid;
    gap: var(--dimension-x4);
    align-content: start;
  }

  .store-section h2,
  .store-section p {
    margin-bottom: 0;
  }

  .store-section > p:not(.section-kicker) {
    color: var(--color-fg-neutral-muted);
  }

  .map-primary {
    margin-top: var(--dimension-x2);
  }

  .map-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dimension-x4);
  }

  .map-secondary a {
    color: var(--color-fg-neutral-muted);
    font-size: var(--font-size-t4);
  }

  .hours-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--dimension-x3) var(--dimension-x4);
    margin: 0;
    padding-block: var(--dimension-x2);
  }

  .hours-list dt {
    color: var(--color-fg-neutral-muted);
  }

  .hours-list dd {
    margin: 0;
    font-weight: var(--font-weight-bold);
    text-align: right;
  }

  .notice p {
    margin: var(--dimension-x1) 0 0;
  }

  .arrival-list {
    border-top: 1px solid var(--color-stroke-neutral-muted);
  }

  .arrival-list article {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--dimension-x4);
    border-bottom: 1px solid var(--color-stroke-neutral-subtle);
    padding-block: var(--dimension-x5);
  }

  .arrival-list :global(.seed-icon) {
    color: var(--color-fg-brand);
  }

  .arrival-list h3,
  .arrival-list p {
    margin-bottom: 0;
  }

  .arrival-list p {
    max-width: 48rem;
    margin-top: var(--dimension-x1);
    color: var(--color-fg-neutral-muted);
  }

  @media (min-width: 48rem) {
    .store-intro,
    .store-details__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
