---
import SeedActionLink from './SeedActionLink';

interface Props {
  href: string;
  label: string;
  variant?: 'brand' | 'weak' | 'outline';
  icon?: 'arrow' | 'clock' | 'external' | 'map' | 'menu' | 'order' | 'phone' | 'waffle';
  event?: string;
  location?: string;
  service?: string;
  class?: string;
}

const {
  href,
  label,
  variant = 'brand',
  icon,
  event,
  location,
  service,
  class: className = '',
} = Astro.props;
---

<SeedActionLink
  href={href}
  label={label}
  variant={variant}
  icon={icon}
  event={event}
  location={location}
  service={service}
  className={className}
/>
