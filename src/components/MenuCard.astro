---
import type { MenuItem } from '@/types/content';
import ActionLink from './ActionLink.astro';
import SeedBadge from './SeedBadge';
import SeedMenuThumbnail from './SeedMenuThumbnail';

interface Props {
  item: MenuItem;
  showOrder?: boolean;
  orderUrl: string;
  location?: string;
}

const { item, showOrder = false, orderUrl, location = 'menu_card' } = Astro.props;
const price = new Intl.NumberFormat('ko-KR', { style: 'currency', currency: 'KRW', maximumFractionDigits: 0 }).format(item.price);
---

<article class="menu-card" data-menu-status={item.status}>
  <SeedMenuThumbnail imageUrl={item.imageUrl} imageAlt={item.imageAlt ?? `${item.name} 메뉴 사진`} />
  <div class="menu-card__body">
    <div class="menu-card__title-row">
      <div>
        <h3>{item.name}</h3>
        <SeedBadge status={item.status} />
      </div>
      <strong class="price">{price}</strong>
    </div>
    <p>{item.description}</p>
    <dl class="menu-card__meta">
      {item.preparationMinutes && <><dt>준비시간</dt><dd>약 {item.preparationMinutes}분</dd></>}
      <dt>알레르기</dt><dd>{item.allergens.length ? item.allergens.join(', ') : '확인 중'}</dd>
    </dl>
    {showOrder && (
      <ActionLink
        href={orderUrl}
        label="메뉴 보고 주문하기"
        variant="weak"
        icon="order"
        event="order_click"
        location={`${location}_${item.id}`}
      />
    )}
  </div>
</article>

<style>
  .menu-card {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    min-width: 0;
    gap: var(--dimension-x4);
    align-content: start;
    border-top: 1px solid var(--color-stroke-neutral-subtle);
    padding-block: var(--dimension-x5) var(--dimension-x6);
  }

  .menu-card :global(.menu-thumbnail) {
    width: 5.5rem;
    height: 5.5rem;
    overflow: hidden;
    border-radius: var(--radius-r3);
    object-fit: cover;
  }

  .menu-card h3 + :global(.seed-badge) {
    margin-top: var(--dimension-x1);
  }

  .menu-card__body {
    display: grid;
    gap: var(--dimension-x3);
    align-content: start;
  }

  .menu-card__title-row {
    display: flex;
    gap: var(--dimension-x4);
    align-items: start;
    justify-content: space-between;
  }

  .menu-card h3,
  .menu-card p {
    margin-bottom: 0;
  }

  .menu-card p {
    color: var(--color-fg-neutral-muted);
    font-size: 0.9375rem;
    line-height: 1.375rem;
  }

  .menu-card__meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--dimension-x1) var(--dimension-x3);
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.125rem;
  }

  .menu-card__meta dt {
    color: var(--color-fg-neutral-subtle);
  }

  .menu-card__meta dd {
    margin: 0;
    font-weight: 700;
  }

  .menu-card :global(.seed-action-link) {
    justify-self: start;
    min-height: 2.75rem;
    padding: 0.6875rem var(--dimension-x4);
    font-size: 0.875rem;
  }

  @media (min-width: 40rem) {
    .menu-card {
      min-height: 15rem;
    }
  }
</style>
