---
import type { SiteSettings } from '@/types/content';
import ActionLink from './ActionLink.astro';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
---

<nav class="mobile-action-bar" aria-label="빠른 매장 행동">
  <ActionLink href={settings.links.order} label="온라인 주문" variant="brand" icon="order" event="order_click" location="mobile_bar" />
  <ActionLink href={settings.telephoneHref} label="전화" variant="weak" icon="phone" event="phone_click" location="mobile_bar" />
  <ActionLink href={settings.links.naverMap} label="길찾기" variant="weak" icon="map" event="directions_click" location="mobile_bar" service="naver" />
</nav>

<style>
  .mobile-action-bar {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--dimension-x2);
    min-height: var(--mobile-bar-height);
    border-top: 1px solid var(--color-stroke-neutral-subtle);
    background: color-mix(in srgb, var(--color-bg-layer-default) 96%, transparent);
    padding: var(--dimension-x2) max(var(--dimension-x2), env(safe-area-inset-right)) calc(var(--dimension-x2) + env(safe-area-inset-bottom)) max(var(--dimension-x2), env(safe-area-inset-left));
    backdrop-filter: blur(14px);
  }

  :global(.mobile-action-bar .seed-action-link) {
    min-width: 0;
    min-height: 3.2rem;
    padding: 0.55rem 0.35rem;
    font-size: 0.79rem;
  }

  @media (min-width: 48rem) {
    .mobile-action-bar {
      display: none;
    }
  }
</style>
