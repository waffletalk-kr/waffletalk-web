---
import type { BusinessHoursEntry, SiteSettings, SpecialHoursEntry } from '@/types/content';
import BusinessStatus from './BusinessStatus.astro';
import Icon from './Icon.astro';

interface Props {
  currentPath: string;
  settings: SiteSettings;
  businessHours: BusinessHoursEntry[];
  specialHours: SpecialHoursEntry[];
}

const { currentPath, settings, businessHours, specialHours } = Astro.props;
const navigation = [
  { href: '/menu', label: '메뉴' },
  { href: '/order', label: '주문' },
  { href: '/store', label: '매장 안내' },
  { href: '/story', label: '이야기' },
];
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="shell-wide site-header__inner">
    <a class="brand" href="/" aria-label={`${settings.name} 홈`}>
      <Icon name="waffle" />
      <strong>{settings.name}</strong>
    </a>
    <nav class="site-nav" aria-label="주요 메뉴">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="site-header__status">
      <BusinessStatus businessHours={businessHours} specialHours={specialHours} compact />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-stroke-neutral-subtle);
    background: color-mix(in srgb, var(--color-bg-layer-default) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    gap: var(--dimension-x4);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--dimension-x2);
    color: var(--color-fg-neutral);
    font-size: 1.25rem;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .brand :global(.icon) {
    color: var(--color-fg-brand);
  }

  .site-nav {
    display: flex;
    gap: var(--dimension-x1);
    overflow-x: auto;
    margin-left: auto;
    scrollbar-width: none;
  }

  .site-nav::-webkit-scrollbar {
    display: none;
  }

  .site-nav a {
    flex: 0 0 auto;
    min-height: 2.75rem;
    border-radius: var(--radius-r2);
    padding: 0.75rem var(--dimension-x3);
    color: var(--color-fg-neutral-muted);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    background: var(--color-bg-neutral-weak);
    color: var(--color-fg-neutral);
    font-weight: 700;
  }

  .site-header__status {
    display: none;
  }

  @media (min-width: 48rem) {
    .site-header__inner {
      min-height: 4.5rem;
    }

    .site-nav {
      margin-inline: auto;
    }

    .site-header__status {
      display: block;
    }
  }
</style>
