---
import type { BusinessHoursEntry, SiteSettings, SpecialHoursEntry } from '@/types/content';
import BusinessStatus from './BusinessStatus.astro';
import Icon from './Icon.astro';

interface Props {
  currentPath: string;
  settings: SiteSettings;
  businessHours: BusinessHoursEntry[];
  specialHours: SpecialHoursEntry[];
}

const { currentPath, settings, businessHours, specialHours } = Astro.props;
const navigation = [
  { href: '/', label: '홈' },
  { href: '/menu', label: '메뉴' },
  { href: '/order', label: '주문' },
  { href: '/store', label: '매장 안내' },
  { href: '/story', label: '이야기' },
];
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="shell-wide site-header__top">
    <a class="brand" href="/" aria-label={`${settings.name} 홈`}>
      <Icon name="waffle" />
      <strong>{settings.name}</strong>
    </a>
    <BusinessStatus businessHours={businessHours} specialHours={specialHours} compact />
  </div>
  <nav class="shell-wide site-nav" aria-label="주요 메뉴">
    {navigation.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid color-mix(in srgb, var(--color-toast-800) 18%, transparent);
    background: color-mix(in srgb, var(--color-cream-50) 94%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__top {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-toast-800);
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    padding-bottom: 0.6rem;
    scrollbar-width: none;
  }

  .site-nav::-webkit-scrollbar {
    display: none;
  }

  .site-nav a {
    flex: 0 0 auto;
    min-height: 2.75rem;
    border-radius: 9999px;
    padding: 0.62rem 0.9rem;
    color: var(--color-ink-700);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    background: var(--color-batter-100);
    color: var(--color-toast-800);
  }

  @media (min-width: 48rem) {
    .site-header {
      position: sticky;
      top: 0;
    }

    .site-header__top {
      min-height: 4rem;
    }

    .site-nav {
      position: absolute;
      top: 0.62rem;
      left: 50%;
      width: auto;
      max-width: 52vw;
      transform: translateX(-50%);
      padding-bottom: 0;
    }
  }
</style>
