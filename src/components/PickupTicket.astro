---
interface Props {
  menuName?: string;
  price?: number;
  preparationMinutes?: number;
}

const { menuName = '생크림 와플', price = 2500, preparationMinutes = 15 } = Astro.props;
const formattedPrice = new Intl.NumberFormat('ko-KR').format(price);
---

<aside class="pickup-ticket" aria-label="대표 메뉴 픽업 안내">
  <div class="pickup-ticket__header">
    <span class="utility">WAFFLE PICK-UP</span>
    <span class="pickup-ticket__number utility">GANGNEUNG · 034</span>
  </div>
  <div class="pickup-ticket__grid" aria-hidden="true">
    <span>W</span><span>A</span><span>F</span><span>F</span><span>L</span><span>E</span>
  </div>
  <div class="pickup-ticket__details">
    <div>
      <span class="utility">대표 메뉴</span>
      <strong>{menuName}</strong>
    </div>
    <div>
      <span class="utility">확인 가격</span>
      <strong>{formattedPrice}원</strong>
    </div>
    <div>
      <span class="utility">준비 안내</span>
      <strong>약 {preparationMinutes}분</strong>
    </div>
  </div>
  <p>가격·판매 여부는 출시 직전에 다시 확인합니다.</p>
</aside>

<style>
  .pickup-ticket {
    position: relative;
    display: grid;
    gap: 1rem;
    overflow: hidden;
    border: 2px solid var(--color-toast-800);
    border-radius: 1rem;
    background: var(--color-cream-50);
    padding: clamp(1.2rem, 4vw, 1.8rem);
    box-shadow: 0.8rem 0.8rem 0 var(--color-toast-800);
    transform: rotate(1deg);
    animation: ticket-enter 300ms cubic-bezier(0, 0, 0.15, 1) both;
  }

  .pickup-ticket::after {
    position: absolute;
    right: 1rem;
    bottom: 0;
    left: 1rem;
    border-top: 2px dashed color-mix(in srgb, var(--color-toast-800) 50%, transparent);
    content: '';
  }

  .pickup-ticket__header {
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    color: var(--color-toast-800);
    font-weight: 700;
  }

  .pickup-ticket__number {
    color: var(--color-ink-700);
    font-size: 0.68rem;
  }

  .pickup-ticket__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    overflow: hidden;
    border: 2px solid var(--color-toast-800);
    border-radius: 0.7rem;
    background: var(--color-batter-400);
  }

  .pickup-ticket__grid span {
    display: grid;
    min-height: 4.5rem;
    place-items: center;
    border: 1px solid rgba(90, 46, 27, 0.32);
    color: var(--color-toast-800);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 8vw, 2.7rem);
    font-weight: 700;
  }

  .pickup-ticket__details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }

  .pickup-ticket__details div {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .pickup-ticket__details span {
    color: var(--color-ink-700);
    font-size: 0.68rem;
  }

  .pickup-ticket__details strong {
    line-height: 1.3;
  }

  .pickup-ticket p {
    margin: 0;
    color: var(--color-ink-700);
    font-size: 0.76rem;
  }

  @keyframes ticket-enter {
    from {
      opacity: 0;
      transform: translateY(0.8rem) rotate(1deg);
    }
  }

  @media (max-width: 23rem) {
    .pickup-ticket__details {
      grid-template-columns: 1fr;
    }
  }
</style>
