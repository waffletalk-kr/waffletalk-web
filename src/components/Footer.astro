---
import type { SiteSettings } from '@/types/content';
import ActionLink from './ActionLink.astro';

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <p class="section-kicker">강릉 옥천동 테이크아웃</p>
      <h2>{settings.name}</h2>
      <p>{settings.description}</p>
    </div>
    <div class="site-footer__info">
      <address>{settings.address}</address>
      <a href={settings.telephoneHref} data-analytics-event="phone_click" data-analytics-location="footer">{settings.telephone}</a>
      <div class="action-row">
        <ActionLink href={settings.links.order} label="메뉴 보고 주문하기" icon="order" event="order_click" location="footer" />
        <ActionLink href={settings.links.naverMap} label="길찾기" icon="map" variant="outline" event="directions_click" location="footer" service="naver" />
      </div>
    </div>
  </div>
  <div class="shell site-footer__bottom">
    <small>© {new Date().getFullYear()} {settings.name} · 테이크아웃 중심 매장</small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-stroke-neutral-subtle);
    background: var(--color-bg-layer-fill);
    padding-block: var(--dimension-x16) var(--dimension-x6);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--dimension-x8);
  }

  .site-footer h2 {
    margin-bottom: var(--dimension-x2);
    font-size: 1.5rem;
  }

  .site-footer__info {
    display: grid;
    gap: var(--dimension-x3);
    align-content: start;
  }

  .site-footer address {
    font-style: normal;
    font-weight: 700;
  }

  .site-footer p,
  .site-footer a,
  .site-footer small {
    color: var(--color-fg-neutral-muted);
  }

  .site-footer__bottom {
    margin-top: var(--dimension-x8);
    border-top: 1px solid var(--color-stroke-neutral-subtle);
    padding-top: var(--dimension-x4);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
