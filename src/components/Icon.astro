---
interface Props {
  name: 'arrow' | 'clock' | 'external' | 'map' | 'menu' | 'order' | 'phone' | 'waffle';
  label?: string;
}

const { name, label } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {name === 'arrow' && <path d="M5 12h13m-5-5 5 5-5 5" />}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'external' && <><path d="M14 5h5v5" /><path d="m19 5-8 8" /><path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></>}
  {name === 'map' && <><path d="M9 18 4.5 20V6L9 4l6 2 4.5-2v14L15 20l-6-2Z" /><path d="M9 4v14m6-12v14" /></>}
  {name === 'menu' && <><path d="M5 7h14M5 12h14M5 17h14" /></>}
  {name === 'order' && <><path d="M7 4.5h10v15H7z" /><path d="M9.5 8h5m-5 4h5m-5 4H13" /></>}
  {name === 'phone' && <path d="M7.2 4.5 10 8l-1.8 2.2a14 14 0 0 0 5.6 5.6L16 14l3.5 2.8-1.1 2.1c-.4.8-1.4 1.2-2.3.9C9.8 17.9 6.1 14.2 4.2 7.9c-.3-.9.1-1.9.9-2.3l2.1-1.1Z" />}
  {name === 'waffle' && <><rect x="4" y="4" width="16" height="16" rx="3" /><path d="M9.3 4v16m5.4-16v16M4 9.3h16M4 14.7h16" /></>}
</svg>
