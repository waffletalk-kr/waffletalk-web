---
interface Props {
  name: 'arrow' | 'clock' | 'external' | 'map' | 'menu' | 'order' | 'phone' | 'waffle';
  label?: string;
}

const { name, label } = Astro.props;
import SeedIcon from './SeedIcon';
---

{name === 'waffle' ? (
  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
    <rect x="4" y="4" width="16" height="16" rx="5" />
    <path d="M9.3 4v16m5.4-16v16M4 9.3h16M4 14.7h16" />
  </svg>
) : (
  <SeedIcon name={name} />
)}
